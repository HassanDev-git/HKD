{
  "name": "hkd",
  "displayName": "HKD",
  "description": "Syntax highlighting, language features, and debugging for the HKD programming language",
  "version": "1.1.1",
  "publisher": "hkd-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HassanDev-git/HKD.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Formatters",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:hkd",
    "onDebugResolve:hkd-debug"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run compile",
    "test": "node ../scripts/vscode-extension-smoke.cjs",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "contributes": {
    "languages": [
      {
        "id": "hkd",
        "aliases": [
          "HKD",
          "hkd"
        ],
        "extensions": [
          ".hkd",
          ".test.hkd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hkd",
        "scopeName": "source.hkd",
        "path": "./syntaxes/hkd.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "hkd-debug",
        "label": "HKD Debugger",
        "languages": [
          "hkd"
        ],
        "configurationSnippets": [
          {
            "label": "HKD: Launch Current File",
            "description": "Debug active HKD script with breakpoints and stepping",
            "body": {
              "type": "hkd-debug",
              "request": "launch",
              "name": "Debug HKD: ${fileBasename}",
              "program": "${file}",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "hkd.restartServer",
        "title": "HKD: Restart Language Server",
        "category": "HKD"
      },
      {
        "command": "hkd.runFile",
        "title": "HKD: Run Active File",
        "category": "HKD"
      },
      {
        "command": "hkd.debugFile",
        "title": "HKD: Debug Active File",
        "category": "HKD"
      },
      {
        "command": "hkd.doctor",
        "title": "HKD: Run Tooling Doctor",
        "category": "HKD"
      },
      {
        "command": "hkd.installDeps",
        "title": "HKD: Install Project Dependencies",
        "category": "HKD"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "HKD Configuration",
      "properties": {
        "hkd.lsp.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable HKD Language Server Protocol 2.0"
        },
        "hkd.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the HKD CLI executable; leave empty to use hkd from PATH"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.2"
  },
  "overrides": {
    "@vscode/vsce": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    }
  }
}
