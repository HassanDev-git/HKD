// compiler_medium.hkd - Representative ~300 LOC compilation workload
struct Vec2 {
    x: Int
    y: Int
}

struct Entity {
    id: Int
    pos: Vec2
    active: Bool
}

fn create_entity(id: Int, x: Int, y: Int) -> Entity {
    return Entity {
        id: id,
        pos: Vec2 { x: x, y: y },
        active: true
    }
}

fn move_entity(e: Entity, dx: Int, dy: Int) -> Entity {
    let new_x = e.pos.x + dx
    let new_y = e.pos.y + dy
    return Entity {
        id: e.id,
        pos: Vec2 { x: new_x, y: new_y },
        active: e.active
    }
}

fn distance_squared(a: Vec2, b: Vec2) -> Int {
    let dx = a.x - b.x
    let dy = a.y - b.y
    return dx * dx + dy * dy
}

fn compute_bounds(entities_count: Int) -> Int {
    let mut_sum = 0
    let i = 0
    while i < entities_count {
        let e = create_entity(i, i * 2, i * 3)
        let moved = move_entity(e, 5, 5)
        let d = distance_squared(e.pos, moved.pos)
        if d > 10 {
            mut_sum = mut_sum + d
        } else {
            mut_sum = mut_sum + 1
        }
        i = i + 1
    }
    return mut_sum
}

fn process_physics_step(step: Int, damping: Int) -> Int {
    let energy = 1000
    let i = 0
    while i < step {
        let loss = (energy * damping) / 100
        energy = energy - loss
        if energy < 10 {
            return energy
        }
        i = i + 1
    }
    return energy
}

fn evaluate_grid(width: Int, height: Int) -> Int {
    let total = 0
    let x = 0
    while x < width {
        let y = 0
        while y < height {
            if (x + y) % 2 == 0 {
                total = total + (x * y)
            } else {
                total = total - (x + y)
            }
            y = y + 1
        }
        x = x + 1
    }
    return total
}

fn run_pipeline() -> Int {
    let b = compute_bounds(20)
    let p = process_physics_step(5, 10)
    let g = evaluate_grid(10, 10)
    return b + p + g
}

print(to_string(run_pipeline()))
