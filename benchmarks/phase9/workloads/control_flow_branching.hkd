let count_even = 0
let count_odd = 0
let count_mod3 = 0
let i = 0
while i < 100000 {
    if i % 3 == 0 {
        count_mod3 = count_mod3 + 1
    } else {
        if i % 2 == 0 {
            count_even = count_even + 1
        } else {
            count_odd = count_odd + 1
        }
    }
    i = i + 1
}
print(to_string(count_mod3) + "," + to_string(count_even) + "," + to_string(count_odd))
