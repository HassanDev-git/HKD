// compiler_large.hkd - Large ~1200 LOC compilation workload
struct Module_1 {
  id: Int
  weight: Int
  scale: Int
}
fn compute_mod_1(m: Module_1, factor: Int) -> Int {
  let acc = m.weight * factor + m.scale
  let k = 0
  while k < 5 {
    if (acc + k) % 2 == 0 {
      acc = acc + k * 3
    } else {
      acc = acc - k
    }
    k = k + 1
  }
  return acc
}

