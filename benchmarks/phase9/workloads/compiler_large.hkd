    if (acc + k) % 2 == 0 {
      acc = acc + k * 3
    } else {
      acc = acc - k
    }
    k = k + 1
  }
  return acc
}

struct Module_59 {
  id: Int
  weight: Int
  scale: Int
}
fn compute_mod_59(m: Module_59, factor: Int) -> Int {
  let acc = m.weight * factor + m.scale
  let k = 0
  while k < 5 {
    if (acc + k) % 2 == 0 {
      acc = acc + k * 3
    } else {
      acc = acc - k
    }
    k = k + 1
  }
  return acc
}

