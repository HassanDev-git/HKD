{
  "name": "hkd",
  "version": "1.1.1",
  "description": "The HKD Programming Language — compiler, VM, CLI, and standard library",
  "main": "dist/index.js",
  "bin": {
    "hkd": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "fmt": "prettier --write \"src/**/*.ts\"",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "package": "node scripts/package.js",
    "dev": "ts-node src/cli/main.ts"
  },
  "keywords": [
    "programming-language",
    "compiler",
    "interpreter",
    "vm"
  ],
  "author": "HKD Language Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@zigc/cli": "^0.16.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  },
  "dependencies": {
    "@types/readline-sync": "^1.4.8",
    "chalk": "^5.3.0",
    "readline-sync": "^1.4.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
