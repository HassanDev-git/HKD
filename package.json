{
  "name": "hkd",
  "version": "1.1.0",
  "description": "The HKD Programming Language — compiler, VM, CLI, and standard library",
  "main": "dist/index.js",
  "bin": {
    "hkd": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint src --ext .ts",
    "fmt": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rmdir /s /q dist 2>nul || true",
    "package": "node scripts/package.js",
    "dev": "ts-node src/cli/main.ts"
  },
  "keywords": [
    "programming-language",
    "compiler",
    "interpreter",
    "vm"
  ],
  "author": "HKD Language Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@zigc/cli": "^0.16.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  },
  "dependencies": {
    "@types/readline-sync": "^1.4.8",
    "chalk": "^5.3.0",
    "readline-sync": "^1.4.10"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "esModuleInterop": true,
            "allowSyntheticDefaultImports": true,
            "strict": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
