import http

fn format_response(status_code, message) {
    if status_code == 200 {
        return "HTTP 200 OK: " + message
    }
    return "HTTP 500 ERROR: " + message
}

fn handle_request(route) {
    if route == "/health" {
        return 200
    }
    if route == "/api" {
        return 200
    }
    return 404
}

fn main() {
    print("=== HKD Real-World HTTP Service ===")
    let server = http.serve(8080)
    print("Server initialized on port 8080")

    let health_resp = http.get("127.0.0.1", 8080, "/health")
    let status = health_resp.status
    let body = health_resp.body
    print("GET /health -> Status: ")
    print(status)
    print("Body: ")
    print(body)

    let metrics = http.metrics()
    print("Metrics status: ")
    print(metrics.status)
}

main()
