// Fibonacci sequence in HKD

fn fibonacci(n: Int) -> Int {
    if n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

// Iterative version (faster)
fn fibonacci_iter(n: Int) -> Int {
    if n <= 1 {
        return n
    }

    let a = 0
    let b = 1
    let i = 2

    while i <= n {
        let temp = a + b
        a = b
        b = temp
        i = i + 1
    }

    return b
}

// Print first 10 Fibonacci numbers (recursive)
print("Fibonacci (recursive):")
let i = 0
while i < 10 {
    print("  fib(" + to_string(i) + ") = " + to_string(fibonacci(i)))
    i = i + 1
}

// Print first 20 Fibonacci numbers (iterative)
print("")
print("Fibonacci (iterative, first 20):")
let nums = []
let j = 0
while j < 20 {
    nums = nums
    j = j + 1
}

print(to_string(fibonacci_iter(10)))
print(to_string(fibonacci_iter(20)))
